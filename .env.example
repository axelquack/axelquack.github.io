# Setting names only. Copy to .env locally if you need these. Leave values empty.
# Do not commit .env. Production secrets stay in GitHub Actions and Proton Pass.

# Local notes directory for garden/scripts/export-published.mjs. Required by that script.
GARDEN_VAULT=

# Local passphrase for garden/scripts/encrypt.mjs. Not the production value.
GARDEN_SITE_PASSWORD=

# Alternate name accepted by the garden encrypt script.
SITE_PASSWORD=
