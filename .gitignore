*.bak*
.DS_Store

# Keys and credentials
*.pem
*.key
id_rsa*
id_ed25519*
auth*.json
*credentials*

# Session exports
*session-export*
*session_export*

# Common caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.venv/
__pycache__/
*.pyc
.tox/
.coverage
htmlcov/

